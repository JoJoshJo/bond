# ---- Project / OS clutter ----
.DS_Store
**/.DS_Store
Thumbs.db
*.log

# ---- Secrets / config (keep keys OUT of git) ----
.env
.env.*
# real Supabase URL + anon key live here (use env.example.json as the template)
env.json

# ---- Flutter / Dart ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
# NOTE: pubspec.lock is intentionally committed (app repo → reproducible builds).

# Miscellaneous
*.class
*.pyc
*.swp
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code — keep launch.json (dart-define wiring), ignore local settings
.vscode/*
!.vscode/launch.json

# ---- Android ----
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks

